# Copie este arquivo para ".env" e preencha:

# Token do bot (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=

# Sua ID do Discord (para você ter acesso total sempre)
OWNER_ID=

# IA (opcional - qualquer API compatível com OpenAI)
# Ex: OpenAI, Groq (grátis), OpenRouter...
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
